# Deploy script configuration. Copy this file to .env before deploying.

# RPC endpoint for the network you are deploying to (must change for mainnet deployment)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Signing: The deploy script reads PRIVATE_KEY from this file by default.
# WARNING: Storing private keys in files is a security risk. Use this for testnet
# deployments only and only if you know what you are doing. For mainnet, prefer
# a more secure approach (see below).
PRIVATE_KEY=0x...

# Safer alternatives (pass directly to forge instead):
#   forge script script/01_Deploy.s.sol --ledger          (hardware wallet)
#   forge script script/01_Deploy.s.sol --trezor          (hardware wallet)
#   forge script script/01_Deploy.s.sol --account mykey   (encrypted keystore via cast wallet)
#   forge script script/01_Deploy.s.sol --interactive     (prompts for private key at runtime)

# Optional: admin EOA to receive token ownership and registry governance.
# If unset, the deployer keeps both. If set and different from the deployer,
# the deploy script transfers them to this address at the end.
# ADMIN_ADDRESS=0x...

# Deployed addresses (filled in after running the scripts)
# BVSTOKEN_ADDRESS=
# BVSREGISTRY_ADDRESS=
# SX_SPACE_ADDRESS=

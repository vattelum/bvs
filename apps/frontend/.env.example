# BVS frontend configuration. Copy this file to .env after running the deploy
# scripts and fill in the addresses they print.

# Deployed BVSToken contract address
VITE_BVS_TOKEN_ADDRESS=0x...

# Deployed BVSRegistry contract address.
# The value below points at the public BVS demo registry on Sepolia so you
# can clone, `npm install && npm run dev`, and browse it immediately.
# Replace it with the BVSRegistry address your own deploy prints before
# running the frontend against your own deployment.
VITE_BVS_REGISTRY_ADDRESS=0xD9939324F06d5794d41971A938095197A7816d89

# Snapshot X Space deployed by script/02_CreateVotingSpace.s.sol
VITE_SX_SPACE_ADDRESS=0x...

# sx-evm authenticator (EthTxAuthenticator) on the same network
VITE_AUTHENTICATOR_ADDRESS=0x...

# sx-evm execution strategy used by the Space (single VanillaExecutionStrategy)
VITE_EXECUTION_STRATEGY_ADDRESS=0x...

# Admin EOA: matches BVSToken.owner() / BVSRegistry.governanceAuthority(). Used
# by the frontend to gate admin actions (mint, approve, reject) without an
# extra contract call per page load.
VITE_ADMIN_ADDRESS=0x...

# Chain ID: 11155111 for Sepolia, 1 for Ethereum mainnet
VITE_CHAIN_ID=11155111

# Block number when contracts were deployed (speeds up event log scanning)
VITE_DEPLOY_BLOCK=0

# Public RPC endpoint for your target network (use a public one, or Infura/Alchemy)
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: allow all token holders to create proposals. Default false (admin-only,
# matching the WhitelistProposalValidationStrategy default in the deploy script).
# Flip to true if you've also called Space.setProposalValidationStrategy() on-chain
# to swap in VanillaProposalValidationStrategy.
VITE_MEMBERS_CAN_PROPOSE=false

# Arweave uploads use the connected wallet via ArDrive Turbo. No private key needed.
